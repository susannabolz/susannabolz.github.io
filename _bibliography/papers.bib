@techreport{birkholz2025_regional,
  type = {Bremen {{Papers}} on {{Economics}} \& {{Innovation}}},
  title = {Regional {{Capabilities}} for {{Green Hydrogen}}: {{Insights}} from {{Northern}} and {{Western Germany}}},
  author = {Birkholz, Jessica and Bolz, Susanna and Jindra, Bj{\"o}rn and Kerner, Philip},
  year = 2025,
  number = {2505},
  doi = {10.26092/elib/4445},
  abstract = {Green hydrogen can play a major role in future net-zero energy systems. This paper investigates how existing technological and production capabilities can support the emergence and growth of green hydrogen value chains in Northern and Western Germany. Drawing on evolutionary economic geography, we argue that the development of the hydrogen value chain depends on the relatedness between existing knowledge bases and hydrogen technologies, and further recombinant capabilities, as well as the processes involved in acquiring capabilities. Our analysis focuses on seven NUTS 2 regions with favorable conditions for the development of hydrogen hubs, which are low cost of renewable energy production, access to hydrogen infrastructure, and political support for the hydrogen economy. We comparatively examine the regional capabilities using patent data to map technological innovation, firm-level data to identify key corporate actors, and regionalized export statistics to assess production capabilities. Based on our findings, we argue that the development of green hydrogen hubs might be facilitated by alignment between a region's existing innovation capabilities, production capabilities, and hub specialization, with place-based policy approaches tailored towards each region's unique profile.},
  langid = {english}
}


@article{bolz2024_regional,
  title = {Regional Capabilities and Hydrogen Adoption Barriers},
  author = {Bolz, Susanna and Thiele, Julian and Wendler, Tobias},
  year = 2024,
  journal = {Energy Policy},
  number = {185},
  doi = {10.1016/j.enpol.2023.113934},
  abstract = {Hydrogen is gaining importance to decarbonize the energy system and tackle the climate crisis. This exploratory study analyzes three focus groups with representatives from relevant organizations in a Northern German region that has unique beneficial characteristics for the transition to a hydrogen economy. Based upon this data, (1) a category system of innovation adoption barriers for hydrogen technologies is developed, (2) decision levels associated with the barriers are identified, (3) detailed insights on how decision levels contribute to the adoption barriers are provided and (4) the barriers are evaluated in terms of their importance. Our analysis adds to existing literature by focusing on short-term barriers and exploring relevant decision levels and their associated adoption barriers. Our main results comprise the following: flaws in the funding system, complex approval procedures, lack of networks and high costs contribute to hydrogen adoption barriers. The (Sub-)State level is relevant for the uptake of the hydrogen economy. Regional entities have leeway to foster the hydrogen transition, especially with respect to the distribution infrastructure. Funding policy, technological suitability, investment and operating costs, and the availability of distribution infrastructure and technical components are highly important adoption barriers that alone can impede the transition to a hydrogen economy.},
  langid = {english}
}


@document{bolz2026_do,
  title = {Do Local Energy Agencies Accelerate the Solar Expansion in Germany? [Under review at Environmental Innovation and Sustainability Transitions]},
  author = {Bolz, Susanna},
year = 2026,
  abstract = {While national policies are essential, local authorities have agency to implement additional measures to accelerate the transition. This paper examines the impact of a specific measure at the county level, \ac{EA}s, on solar PV adoption in Germany. These agencies, founded since 1992, serve as contact points for citizens, municipalities, and companies, focusing on consultancy and networking for renewable energy and energy efficiency.
Primarily using data from the Core Energy Market Data Registry and an originally compiled dataset on \ac{EA}, the analysis utilizes augmented synthetic controls to account for staggered agency adoption. 
Overall, results indicate that both geographical proximity and institutional settings matter for the effectiveness of \ac{EA}s. 
While effect sizes in general are small and the standard errors are large, a stable pattern emerges: The foundation of a \ac{EA} increases the number of new actors that install rooftop solar PV for the first time, but only to a limited extent. The effect is higher for \ac{EA}s with a solar focus, in counties where there is an LEAs office, and in smaller counties.},
  langid = {english}
}



@document{bolz2026_sustainability,
  title = {Industry Competition, Regulation, and Climate Action: Evidence from the German Sustainability Code Disclosures [Unpublished Manuscript]},
  author = {Birkholz, Jessica and Bolz, Susanna and Siebert, Wiebke},
year = 2026,
  abstract = {This paper studies how competitive and regulatory pressures shape firms’ sustainability reporting behavior. Using sustainability reports published under the German Sustainability Code between 2010 and 2024, we examine how industry competition and regulatory exposure affect the quantity and quality of climate-related disclosures. Climate-related commitments and actions are extracted from 3,760 reports using ClimateBERT-based text analysis, enabling the construction of novel sustainability-reporting indicators. Competitive pressure is measured using industry-level markups derived from firm-level accounting data, while regulatory pressure is proxied by exposure to the EU Emissions Trading System. Our results suggests that stronger competition tends to be associated with a higher volume of climate-related discussion and commitments, but with less specificity in these commitments. In contrast, regulatory pressure increases the number and specificity of reported commitments without affecting the overall volume of climate-related discussion. These findings suggest that sustainability reporting may reflects firms’ strategic responses to both market competition and environmental regulation.},
  langid = {english}
}



@document{bolz2026_sustainability,
  title = {Building Resilience for a Sustainable Future: A Review of Stressors and Resilience Characteristics in Subnational Social Systems [Unpublished manuscript]},
  author = {Bolz, Susanna and Masyutina, Olga},
year = 2026,
  abstract = {As complex social systems are facing increasing environmental and societal pressures and uncertainties, calls for sustainability transitions are becoming more urgent. In analyzing sustainability transitions, the concept of resilience and particularly its adaptive and transformative qualities have gained prominence. In this paper, we systematically review empirical literature that studies resilience of social systems in transition at the subnational level - sub-local, local and regional. First, we identify and group stressors that act on social systems in five categories: climate change impact, climate change mitigation, the Covid-19 pandemic, economic development and societal transformation. Second, we identify system characteristics that contribute to or undermine system resilience and situate them within broad resilience dimensions and across the three spatial levels. We find that most characteristics, e.g. knowledge, good governance, equality, participation and collaboration, enhance system resilience but there is a noticeable variation across the dimensions and spatial scales. Our findings contribute to a more nuanced understanding of multi-dimensional, multi-factor and multi-level nature of resilience and can offer useful insights for policy-makers and researchers alike.},
  langid = {english}
}


@document{bolz2026_greener,
title = {Greener Pastures? Examining the Role of EU Funding in Regional Disparities for Green Technologies [Manuscript in preparation]},
author = {Bolz, Susanna},
year = 2026,
abstract = {The relationship between public funding and regional inequality is a pivotal topic for the design of future funding policies. The European Commission’s strategic agenda includes a successful green transition as well as economic prosperity for European regions.  However, recent research found that public R&D funding in Europe reinforces regional disparities and that public R&D funding tends to be allocated to better-endowed regions, counteracting the European Commission’s goals. An open question is whether publicly funded research for green technologies reinforce or mitigate regional disparities.
Two mechanisms play out: on the one hand, green technologies are characterized by a higher degree of complexity, and higher levels of technical expertise compared to technologies in general. Thus, the allocation of EU public funding for green technologies is likely to contribute to reinforcing regional inequalities. On the other hand, green technologies are characterized by a higher degree of inter-regional cooperation compared to technologies in general. This increased inter-regional cooperation is likely to contribute to mitigate regional inequalities.  Thus, this study investigates whether EU funding for green technologies reinforces or mitigates regional disparities in Europe. 
This paper utilizes the CORDIS database. The CORDIS database includes projects from the Horizon, Horizon 2020, and FP7 programs. Each project gets assigned a EuroSciVoc classification, which allows to distinguish between different scientific fields projects contribute to. For the purpose of this paper, engineering projects in general are selected. Further, it is distinguished between engineering projects dealing with different green technologies, more specifically renewable energy, green hydrogen, and carbon capture and storage. The CORDIS data further encompass information about the location of project participants, which allows to assess the degree of inter- and intra-regional cooperation for the projects. Panel methods are employed to analyze the impact of funding allocations on regional disparities.
This study delivers insights into the dynamics between EU funding, structural inequality in regional contexts, and funding for green technologies. Results are relevant for policy-makers to improve the design of future public R&D programs.},
langid = {english}
}


@dataset{bolz2026_local,
  title = {Local Energy Agencies in {{Germany}}},
  author = {Bolz, Susanna},
  date = {2026-03-02},
  publisher = {Zenodo},
  doi = {10.5281/ZENODO.18633173},
  abstract = {Local energy agencies (LEAs) have been funded in the last decades to support climate action. Existing databases such as ManagEnergy are incomplete. Thus, this dataset provides information about the foundation of LEAs in Germany, based upon extensive research of a variety of data sources. The dataset includes the name, website, foundation year, number of employees, solar focus, NUTS3 codes, postal codes and whether companies are part of the LEA.},
  langid = {english},
  version = {1.0},
  keywords = {Climate policy,energy agency,Germany,Local authority}
}



