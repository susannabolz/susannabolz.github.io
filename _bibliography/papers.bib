@article{bolz2024_regional,
  title = {Regional Capabilities and Hydrogen Adoption Barriers},
  author = {Bolz, Susanna and Thiele, Julian and Wendler, Tobias},
  year = 2024,
  journal = {Energy Policy},
  number = {185},
  doi = {10.1016/j.enpol.2023.113934},
  abstract = {Hydrogen is gaining importance to decarbonize the energy system and tackle the climate crisis. This exploratory study analyzes three focus groups with representatives from relevant organizations in a Northern German region that has unique beneficial characteristics for the transition to a hydrogen economy. Based upon this data, (1) a category system of innovation adoption barriers for hydrogen technologies is developed, (2) decision levels associated with the barriers are identified, (3) detailed insights on how decision levels contribute to the adoption barriers are provided and (4) the barriers are evaluated in terms of their importance. Our analysis adds to existing literature by focusing on short-term barriers and exploring relevant decision levels and their associated adoption barriers. Our main results comprise the following: flaws in the funding system, complex approval procedures, lack of networks and high costs contribute to hydrogen adoption barriers. The (Sub-)State level is relevant for the uptake of the hydrogen economy. Regional entities have leeway to foster the hydrogen transition, especially with respect to the distribution infrastructure. Funding policy, technological suitability, investment and operating costs, and the availability of distribution infrastructure and technical components are highly important adoption barriers that alone can impede the transition to a hydrogen economy.},
  langid = {english}
}


@article{bolz2026_do,
  title = {Do Local Energy Agencies Accelerate the Solar Expansion in {{Germany}}?},
  author = {Bolz, Susanna},
  date = {2027-01},
  journaltitle = {Environmental Innovation and Societal Transitions},
  shortjournal = {Environ. Innov. Soc. Transit.},
  volume = {62},
  pages = {101198},
  issn = {22104224},
  doi = {10.1016/j.eist.2026.101198},
abstract = {This paper examines the impact of a specific district-level measure, local energy agencies (LEAs), on solar PV adoption in Germany. These agencies, founded since 1992, serve as contact points for citizens, municipalities, and companies, focusing on consultancy and networking for renewable energy and energy efficiency. Using data from the Core Energy Market Data Registry and an originally compiled dataset on LEAs, the analysis utilizes augmented synthetic controls to account for staggered agency adoption. A significant effect of the foundation of LEAs on new solar adopters, measured as the number of actors installing solar PV for the first time per 10,000 inhabitants, cannot be established. The result holds for different subgroups of new adopters, model specifications, and dependent variables. Effect sizes are generally small and standard errors are large. A positive or negative significant effect cannot be established for LEAs in general or for LEAs with certain characteristics.},
  langid = {english}
}
 


@document{bolz2026_sustainability,
  title = {Markets or Mandates? How Competition and Regulation Shape Climate Relevance, Commitments, and Cheap Talk in Sustainability Reporting [Under review at Business Strategy and the Environment]},
  author = {Birkholz, Jessica and Bolz, Susanna and Siebert, Wiebke},
year = 2026,
  abstract = {This paper studies how competitive and regulatory pressures shape firms’ sustainability reporting behavior in terms of the relevance of climate topics, the quantity and quality of climate commitments and actions. These climate-related commitments and actions are extracted from 3,650 sustainability reports published under the German Sustainability Code between 2010 and 2024 using ClimateBERT-based models. Competitive pressure is measured using industry-level markups derived from firm-level accounting data from Orbis, while regulatory pressure is proxied by exposure to the German and European Emissions Trading Systems. Competitive pressure is associated with higher climate relevance but lower report quality, while regulatory pressure is associated with lower climate relevance but higher report quality; neither is associated with a higher quantity of climate commitments and actions. The findings suggest that firms strategically manage legitimacy in response to both market competition and environmental regulation.},
  langid = {english}
}






@techreport{bolz2026_sustainability,
  title = {Resilience in Place-Based Sustainability Transitions: A Systematic Review of Disturbances, System Capacities and Spatial Contexts [Forthcoming]},
  author = {Masyutina, Olga and Susanna Bolz},
year = {2026},
  type = {Bremen Papers on Economics \& Innovation},
number = {2603},
  abstract = {As complex social systems face increasing environmental and societal pressures, understanding their resilience is central to sustainability transitions. We systematically review 65 empirical studies of resilience in subnational social systems and develop a conceptual synthesis of resilience through three complementary analytical lenses: disturbances, system capacities and spatial contexts. We first classify disturbances along three dimensions--temporal structure, origin and domain--highlighting their overlapping and often multi-causal nature. We further synthesize thirteen resilience characteristics into four interrelated capacities: structural, relational, governance and dynamic. Our findings show that resilience is shaped not by individual capacities but by their combination in response to different disturbances. Their prominence also varies across spatial scales, indicating that resilience is spatially embedded. We argue that resilience is therefore best understood as a place-based, multidimensional process emerging from interactions between disturbances, capacities and the contexts in which systems operate.},
  langid = {english}
}


@dataset{bolz2026_local,
  title = {Local Energy Agencies in Germany [Dataset]},
  author = {Bolz, Susanna},
  year = {2026},
  journal = {Zenodo},
  doi = {10.5281/ZENODO.18633173},
  abstract = {Local energy agencies (LEAs) have been funded in the last decades to support climate action. Existing databases such as ManagEnergy are incomplete. Thus, this dataset provides information about the foundation of LEAs in Germany, based upon extensive research of a variety of data sources. The dataset includes the name, website, foundation year, number of employees, solar focus, NUTS3 codes, postal codes and whether companies are part of the LEA.},
  langid = {english},
  version = {1.0},
  keywords = {Climate policy,energy agency,Germany,Local authority}
}



@dataset{bolz_2026_19952486,
  author       = {Bolz, Susanna},
  title        = {mastr-r [R code]},
  abstract = {The Marktstammdatenregister (CEMDR - Core Energy Market Data Registry) provides bulk downloads in XML format. This code provides scripts to process and merge datasets from the CEMDR. The code is easily adaptable to individual needs. Users can: 1. read the XML file of the CEMDR bulk download, 2. select variables of interest, 3. map postal codes to NUTS or AGS codes, 4. extract days, weeks, months or years from dates, 5. merge datasets. The datasets are then saved as parquet files.},
  year         = {2026},
  publisher    = {Zenodo},
  version      = {v1.0.0},
  doi          = {10.5281/zenodo.19953364},
  url          = {https://doi.org/10.5281/zenodo.19953364}
}
